{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sickcc.online/cw/character.schema.json",
  "title": "AIDeskPal-SICK Character Profile",
  "type": "object",
  "required": ["schema_version", "model", "id", "name", "prompt"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "1.0.0"] },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "title": { "type": "string", "maxLength": 120 },
    "version": { "type": "string", "maxLength": 40 },
    "author": { "type": "string", "maxLength": 120 },
    "prompt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 6000,
      "description": "Trusted character/role prompt bound to this model. It cannot grant new capabilities."
    },
    "speech_style": { "type": "string", "maxLength": 1000 },
    "greeting": { "type": "string", "maxLength": 300 },
    "boundaries": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 300 }
    },
    "likes": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 80 }
    },
    "examples": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
