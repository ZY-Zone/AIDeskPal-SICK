# Normalise line endings in the working tree so a clone on any platform matches.
* text=auto

# Windows launchers and the VBS shim are consumed by cmd.exe / wscript.exe and
# must keep CRLF regardless of the authoring platform.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.ico binary
*.png binary
*.zip binary
