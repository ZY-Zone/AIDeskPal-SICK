{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sickcc.online/cw/plugin.schema.json",
  "title": "AIDeskPal-SICK Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "api_version", "entry"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,80}$",
      "description": "Reverse-domain-like stable plugin id."
    },
    "name": { "type": "string", "maxLength": 80 },
    "version": { "type": "string", "maxLength": 30 },
    "api_version": { "type": "integer", "const": 1 },
    "entry": { "type": "string", "description": "Relative Python file inside the plugin folder." },
    "description": { "type": "string", "maxLength": 600 },
    "author": { "type": "string", "maxLength": 120 },
    "homepage": { "type": "string" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "context.read",
          "actions.play",
          "actions.register",
          "speech",
          "ui.tray",
          "events",
          "settings.read",
          "settings.write",
          "network"
        ]
      }
    }
  }
}
